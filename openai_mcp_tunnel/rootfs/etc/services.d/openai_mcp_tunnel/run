#!/usr/bin/with-contenv bashio
# OpenAI Secure MCP Tunnel service for Home Assistant OS.

set -euo pipefail

CONTROL_PLANE_TUNNEL_ID="$(bashio::config 'tunnel_id')"
CONTROL_PLANE_API_KEY="$(bashio::config 'runtime_api_key')"
HA_MCP_TOKEN="$(bashio::config 'ha_token')"
MCP_SERVER_URL="$(bashio::config 'mcp_server_url')"

if [[ -z "${CONTROL_PLANE_TUNNEL_ID}" ]]; then
  bashio::log.error "The OpenAI tunnel ID is required."
  exit 1
fi

if [[ -z "${CONTROL_PLANE_API_KEY}" ]]; then
  bashio::log.error "The OpenAI runtime API key is required."
  exit 1
fi

if [[ -z "${HA_MCP_TOKEN}" ]]; then
  bashio::log.error "A dedicated Home Assistant long-lived access token is required."
  exit 1
fi

if [[ -z "${MCP_SERVER_URL}" ]]; then
  bashio::log.error "The Home Assistant MCP server URL is required."
  exit 1
fi

# Keep secrets in the process environment only. Never print these values.
export CONTROL_PLANE_TUNNEL_ID
export CONTROL_PLANE_API_KEY
export HA_MCP_TOKEN
export MCP_SERVER_URL

# Attach the HA bearer token only to requests sent to the configured MCP origin.
# Discovery headers are separate so OAuth metadata and startup probes authenticate too.
export MCP_EXTRA_HEADERS="Authorization: env:HA_MCP_TOKEN"
export MCP_DISCOVERY_EXTRA_HEADERS="Authorization: env:HA_MCP_TOKEN"

# Keep the embedded status UI private to this container; no inbound port is exposed.
export HEALTH_LISTEN_ADDR="127.0.0.1:8080"
export LOG_LEVEL="info"
export LOG_FORMAT="struct-text"

bashio::log.info "Starting OpenAI Secure MCP Tunnel client."
exec /usr/bin/tunnel-client run
